p2k: allow machine-specific PIT divisor scaling

Pinball 2000 uses IRQ0 as its game-time clock.  Provide a narrow weak hook at
the i8254 count-load boundary so the out-of-tree machine can deliberately run
that clock below or above its physical 4003.97 Hz rate.  The upstream default
is identity and therefore changes no other machine.

--- a/hw/timer/i8254.c
+++ b/hw/timer/i8254.c
@@ -105,6 +105,9 @@ static void pit_set_channel_gate(PITCommonState *s, PITChannelState *sc,
     sc->gate = val;
 }
 
+__attribute__((weak)) int p2k_pit_scale_count(int channel, int count)
+{ return count; }
+
 static inline void pit_load_count(PITChannelState *s, int val)
 {
     if (val == 0)
@@ -174,17 +177,20 @@ static void pit_ioport_write(void *opaque, hwaddr addr,
         switch(s->write_state) {
         default:
         case RW_STATE_LSB:
+            val = p2k_pit_scale_count(addr, val);
             pit_load_count(s, val);
             break;
         case RW_STATE_MSB:
+            val = p2k_pit_scale_count(addr, val << 8);
-            pit_load_count(s, val << 8);
+            pit_load_count(s, val);
             break;
         case RW_STATE_WORD0:
             s->write_latch = val;
             s->write_state = RW_STATE_WORD1;
             break;
         case RW_STATE_WORD1:
-            pit_load_count(s, s->write_latch | (val << 8));
+            val = p2k_pit_scale_count(addr, s->write_latch | (val << 8));
+            pit_load_count(s, val);
             s->write_state = RW_STATE_WORD0;
             break;
         }

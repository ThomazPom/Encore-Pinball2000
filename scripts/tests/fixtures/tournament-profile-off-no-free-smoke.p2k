# Verify --tournament 10.0.2.9 off no-free through XINA's resource manager.
reslist data
@assert-regex \[ADTS_IPA\][^\r\n]*[\r\n]+[ ]+09\|02\|00\|0a
@assert-regex \[ADGmTour\][^\r\n]*[\r\n]+[ ]+00\|00\|00\|00
@assert-regex \[ADCrdFPl\][^\r\n]*[\r\n]+[ ]+00\|00\|00\|00
@echo Tournament off/no-free profile verified; close the emulator normally

+/* P2K: queue a hardware interrupt vector and raise CPU_INTERRUPT_HARD so the
+ * TCG core delivers it atomically at the next TB boundary (mirrors main's
+ * `cpu_interrupt(cs, CPU_INTERRUPT_HARD)` after setting the PIC vector). */
+static void x86_raise_irq(struct uc_struct *uc, uint32_t vector)
+{
+    uc->pending_hard_vector = (int32_t)vector;
+    cpu_interrupt(uc->cpu, CPU_INTERRUPT_HARD);
+}

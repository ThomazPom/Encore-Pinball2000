+/*
+ P2K extension: raise a hardware interrupt with an explicit vector, delivered
+ atomically by the TCG core at the next translation-block boundary (only when
+ guest IF=1 and not in an IRQ-inhibit shadow). Restores the QEMU
+ cpu_get_pic_interrupt delivery path that stock Unicorn stubbed out. Use this
+ instead of hand-building the interrupt stack frame to get main/QEMU-parity
+ non-nesting hardware IRQ delivery (e.g. IRQ0 -> vector 0x08).
+
+ @uc: handle returned by uc_open()
+ @vector: interrupt vector number (IDT index) to deliver
+
+ @return UC_ERR_OK on success; UC_ERR_ARG on bad handle / unsupported arch
+*/
+UNICORN_EXPORT
+uc_err uc_x86_raise_irq(uc_engine *uc, uint32_t vector);
